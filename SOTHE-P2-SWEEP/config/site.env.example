# SOTHE-P2-SWEEP site configuration (KEY=VALUE; # starts a comment; $USER and $HOME are expanded).
# `python sweep.py install` writes config/site.env from this template with the values it detects.
# Edit config/site.env, not this file.  Every key has a default in sweep_p2/cli.py.

SLURM_ACCOUNT=modfkt          # UHeM project: sacctmgr -nP show assoc user=$USER format=account
SLURM_PARTITION=cpu2dq        # whole 128-core EPYC 7742 node, charged 1.0x for all 128 cores whatever -c asks
SLURM_WALLTIME=0-01:00        # job limit; the full sweep takes minutes on 128 workers (probe prints an estimate)
SLURM_CPUS=128                # cpus-per-task = worker processes; the node is charged in full, so use all of it
PROBE_WALLTIME=0-00:10
PROBE_CPUS=4

PYTHON_MODULE=ANACONDA/Anaconda3-2024.06-1-python-3.12   # Python 3.12.4, NumPy 1.26.4, SciPy 1.13.1, Matplotlib 3.8.4; 'none' = no module
PYTHON=python                 # interpreter inside the job, after the module load

BLOCKS="B1 B2 B3 B4 B5 B6 B7 B8 B9 B10"   # python sweep.py blocks
RESULTS_DIR=/ari/users/$USER  # where SOTHE-P2-SWEEP_results_<RUNID>.tar.gz is written (WinSCP pick-up point); pack folder if absent
