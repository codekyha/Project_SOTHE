# SOTHE-P2 site configuration (KEY=VALUE; # starts a comment; $USER and $HOME are expanded).
# `python p2.py install` writes config/site.env from this template with the values it detects.
# Edit config/site.env, not this file.  Every key has a default in sothe_p2/cli.py.

SLURM_ACCOUNT=modfkt          # UHeM project: sacctmgr -nP show assoc user=$USER format=account
SLURM_PARTITION=cpu2dq        # whole 128-core EPYC 7742 node, charged 1.0x for all 128 cores whatever -c asks
SLURM_WALLTIME=0-01:00        # main job limit; the full run (S1..S7) takes a few minutes with 40 workers
SLURM_CPUS=40                 # cpus-per-task = worker processes (S2: 36 tasks, S6: 177 eigenproblems, S7: 307 runs)
PROBE_WALLTIME=0-00:10
PROBE_CPUS=2

PYTHON_MODULE=ANACONDA/Anaconda3-2024.06-1-python-3.12   # Python 3.12.4, NumPy 1.26.4, SciPy, Matplotlib; 'none' = no module
PYTHON=python                 # interpreter inside the job, after the module load

STAGES="S1 S2 S3 S4 S5 S6 S7" # S1 C-05 | S2 C-05b | S3 G-12 | S4 T-14 | S5 T-13+T-18 | S6 phase-2 products | S7 Ref. [25] sweep
RESULTS_DIR=/ari/users/$USER  # where SOTHE-P2_results_<RUNID>.tar.gz is written (WinSCP pick-up point); pack folder if absent
